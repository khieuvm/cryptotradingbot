# Dry-run environment overlay
# Copy to dryrun.yaml and fill in your credentials
dry_run: true
dry_run_wallet: 500
stake_amount: 50
max_stake_amount: 100

risk:
  max_open_trades: 6

api_server:
  enabled: true
  port: 8080
  username: admin
  password: admin

telegram:
  enabled: true
  token: ""      # BotFather token
  chat_id: ""    # your chat ID

logging:
  level: INFO
